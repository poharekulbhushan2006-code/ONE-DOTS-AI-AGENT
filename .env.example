# ONE: Always-On Autonomous AI Agent System
# Environment Configuration

# Provider API Keys (Supports OpenAI, Anthropic, Gemini, or local models)
OPENAI_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""

# Default LLM settings
DEFAULT_MODEL="gpt-4o"
LLM_PROVIDER="openai" # openai, gemini, anthropic, or mock

# Core Engine Settings
DATA_DIR="./data"
HEARTBEAT_INTERVAL_SECONDS=60
MAX_AGENT_CYCLES_PER_TICK=10
AUTO_APPROVE_SAFE_ACTIONS=true

# Notification & Escalation Gate
SLACK_WEBHOOK_URL=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
WEBHOOK_ALERT_URL=""

# API & Server Settings
SERVER_HOST="127.0.0.1"
SERVER_PORT=8000

# Security & Defense Settings (OWASP & Enterprise Hardening)
ENVIRONMENT="production"
DEBUG=false
SECRET_KEY=""
ADMIN_API_KEY=""
WEBHOOK_SECRET=""
CAPTCHA_SECRET=""
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
